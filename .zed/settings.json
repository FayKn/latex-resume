{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "file_scan_inclusions": ["resume-preview.png"],
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": true,
            "forwardSearchAfter": false,
            "executable": "/bin/sh",
            "args": [
              ".zed/build-resume.sh",
              "%f"
            ]
          }
        }
      }
    }
  }
}
